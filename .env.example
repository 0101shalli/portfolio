# GitHub OAuth App credentials used by the /admin blog editor (api/auth.js, api/callback.js).
# Create one at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               https://your-domain.com
#   Authorization callback URL: https://your-domain.com/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: "repo,user" if the repository is private.
# GITHUB_OAUTH_SCOPE=public_repo,user

# Optional: canonical site URL for sitemap/RSS/social cards.
# SITE_URL=https://portfolio-indol-ten-20.vercel.app

# Contact form (api/contact.js) — sends messages through https://resend.com
# Sign up with the address that should receive messages, then create an API key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=shallileroi@gmail.com
# Optional: once you verify your own domain in Resend, send from it.
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
